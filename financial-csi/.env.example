# Financial CSI Environment Configuration
# Copy this file to .env and fill in your details.

# Core Settings
PROJECT_NAME="Financial CSI API"
VERSION="0.1.0"
# Backend CORS Configuration
# For local dev use: '["http://localhost:3000", "http://127.0.0.1:3000"]'
# For production use Vercel URL: '["https://your-vercel-app.vercel.app"]'
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:8000"

DATABASE_URL="sqlite:///./financial_csi.db"

# ---------------------------------------------------------
# Razorpay Test Mode Integration
# ---------------------------------------------------------
# NEVER use production credentials here.
# Financial CSI operates in simulation-only mode.

RAZORPAY_ENABLED=true
RAZORPAY_MODE=test

# Get these from your Razorpay Dashboard -> Account & Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Get this from Webhook Settings in Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=
